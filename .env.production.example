# ===================================================
# StudyVault — Environment Configuration Template (Production)
# ===================================================

NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=https://app.studyvault.fr

# Database Connection (PostgreSQL 16)
DATABASE_URL=postgresql://studyvault_user:STRONG_SECURE_PASSWORD@postgres-prod-host:5432/studyvault_db?sslmode=require

# Storage Driver (local | s3)
STORAGE_DRIVER=s3
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_REGION=fr-par
S3_ACCESS_KEY_ID=YOUR_SCW_ACCESS_KEY
S3_SECRET_ACCESS_KEY=YOUR_SCW_SECRET_KEY
S3_BUCKET_NAME=studyvault-prod-documents

# JWT Secrets (Min 32 random characters)
JWT_ACCESS_SECRET=PRODUCTION_JWT_ACCESS_SECRET_PLEASE_CHANGE_ME_32CHARS
JWT_REFRESH_SECRET=PRODUCTION_JWT_REFRESH_SECRET_PLEASE_CHANGE_ME_32CHARS

# Closed Beta Configuration
BETA_CLOSED=true
BETA_MAX_USERS=100

# Transactional Email Service (Resend / SendGrid / Mailgun)
EMAIL_API_KEY=re_123456789_your_resend_api_key
EMAIL_FROM=no-reply@studyvault.fr

# Sentry Monitoring
SENTRY_DSN=https://xxxxxxxxxxxxxxxx@sentry.io/1234567

# Logger
LOG_LEVEL=info
