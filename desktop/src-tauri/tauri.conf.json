{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "build": {
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "devPath": "http://localhost:5173",
    "distDir": "../../frontend/dist"
  },
  "package": {
    "productName": "StudyVault",
    "version": "1.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "dialog": {
        "all": false,
        "ask": true,
        "message": true
      },
      "process": {
        "relaunch": true
      }
    },
    "bundle": {
      "active": true,
      "category": "Education",
      "copyright": "Copyright © 2026 StudyVault",
      "deb": {
        "depends": []
      },
      "externalBin": [],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "fr.studyvault.app",
      "longDescription": "Bibliothèque universitaire SaaS pour étudiants — organisation de cours, coffre-fort personnel, planning OCR et classement intelligent.",
      "macOS": {
        "frameworks": [],
        "minimumSystemVersion": "10.15",
        "exceptionDomain": "",
        "signingIdentity": null,
        "entitlements": null
      },
      "resources": [],
      "shortDescription": "StudyVault — Coffre-fort académique",
      "targets": "all",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/Naomie-Carmen/studyvault/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1OUQwQzcxM0EwMEUyOTMKUldTVDRnQTZjUXlkVmRrSWhpa0Q5QTRDMm9sWWRLbEdSZlFDeXc2Tk93c3B5UGdCRVlEbXNqMzYK",
      "windows": {
        "installMode": "passive"
      }
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 800,
        "resizable": true,
        "title": "StudyVault",
        "width": 1280,
        "center": true,
        "focus": true,
        "visible": true
      }
    ]
  }
}
